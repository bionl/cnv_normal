// nextflow.config – CNVkit PoN pipeline

manifest {
    name        = 'cnvkit-pon'
    author      = 'you'
    description = 'Build a CNVkit panel-of-normals reference from 1000 Genomes BAMs'
    version     = '1.0.0'
    nextflowVersion = '>=23.04.0'
}

// Keep task work files in a project-local writable path
workDir = "${projectDir}/work"

// ---------- default parameters ----------
params {
    help                    = false
    input                   = null
    fasta                   = null
    fasta_fai               = null
    targets                 = null
    antitargets             = null
    access                  = null
    annotate                = null
    outdir                  = "results"
    short_names             = true
    target_avg_size         = 267
    antitarget_avg_size     = 500000
    min_mapq                = 0
    count_reads             = false
    // execution
    max_cpus                = 16
    max_memory              = '64.GB'
    max_time                = '24.h'
}

// ---------- process resource labels ----------
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '16.GB'
        time   = '6.h'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }
}

// ---------- profiles ----------
profiles {

    // Local execution with Docker
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    // BioNL/Standard execution (default for GCP runs)
    standard {
        docker.enabled         = true
        singularity.enabled    = false
        process.scratch        = true

        google {
            project  = 'your-gcp-project-id'  // Update this
            region   = 'europe-west4'

            lifeSciences {
                preemptible  = true
                bootDiskSize = 20.GB
            }
        }
    }

    // HPC / cluster with Singularity
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Slurm HPC
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            withLabel: 'process_low' {
                queue  = 'short'
                cpus   = 2
                memory = '4.GB'
                time   = '2.h'
            }
            withLabel: 'process_medium' {
                queue  = 'normal'
                cpus   = 4
                memory = '16.GB'
                time   = '6.h'
            }
        }
    }

    // Google Cloud (Batch or Life Sciences)
    gcp {
        process.executor       = 'google-batch'
        process.scratch        = true
        google.location        = 'us-central1'
        docker.enabled         = true
        singularity.enabled    = false
    }

    // Test profile with minimal settings
    test {
        params {
            input   = "${projectDir}/test/samplesheet_test.csv"
            fasta   = "${projectDir}/test/genome.fa"
            targets = "${projectDir}/test/targets.bed"
            outdir  = "test_results"
        }
        process {
            withLabel: 'process_low'   { cpus = 1; memory = '2.GB' }
            withLabel: 'process_medium' { cpus = 2; memory = '4.GB' }
        }
    }
}

// ---------- timeline / report ----------
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
