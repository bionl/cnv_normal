// CNVkit PoN pipeline — Configuration

// ═══════════════════════════════════════════════════════════════════════════
// PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════

params {
    help                = false
    input               = null
    fasta               = null
    fasta_fai           = null
    targets             = null
    antitargets         = null
    access              = null
    annotate            = null
    outdir              = 'results'
    short_names         = true
    target_avg_size     = 267
    antitarget_avg_size = 500000
    min_mapq            = 0
    count_reads         = false
    max_cpus            = 16
    max_memory          = '64 GB'
    max_time            = '24h'
}

// ═══════════════════════════════════════════════════════════════════════════
// PROCESS DEFAULTS
// ═══════════════════════════════════════════════════════════════════════════

process {
    cpus   = 4
    memory = '8 GB'
    time   = '12h'

    errorStrategy = 'terminate'
    maxRetries    = 4

    withLabel: process_low {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '16 GB'
        time   = '6h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// EXECUTOR
// ═══════════════════════════════════════════════════════════════════════════

executor {
    name      = 'local'
    queueSize = 100
}

// ═══════════════════════════════════════════════════════════════════════════
// PROFILES
// ═══════════════════════════════════════════════════════════════════════════

profiles {

    local {
        docker.enabled = false
        conda.enabled  = true
    }

    standard {
        docker.enabled = true
        conda.enabled  = false

        google {
            project = 'your-gcp-project-id'
            region  = 'europe-west4'

            lifeSciences {
                preemptible  = true
                bootDiskSize = 20.GB
            }
        }
    }

    test {
        params {
            input   = "${projectDir}/test/samplesheet_test.csv"
            fasta   = "${projectDir}/test/genome.fa"
            targets = "${projectDir}/test/targets.bed"
            outdir  = 'test_results'
        }
        process {
            withLabel: process_low    { cpus = 1; memory = '2 GB' }
            withLabel: process_medium { cpus = 2; memory = '4 GB' }
        }
    }

    dev {
        process.errorStrategy = 'ignore'
        process.maxRetries    = 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// REPORTING
// ═══════════════════════════════════════════════════════════════════════════

report {
    enabled   = true
    overwrite = true
    file      = 'results/pipeline_report.html'
}

timeline {
    enabled   = true
    overwrite = true
    file      = 'results/timeline_report.html'
}

trace {
    enabled   = true
    overwrite = true
    file      = 'results/trace.txt'
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

dag {
    enabled   = true
    overwrite = true
    file      = 'results/pipeline_dag.html'
}

// ═══════════════════════════════════════════════════════════════════════════
// MANIFEST
// ═══════════════════════════════════════════════════════════════════════════

manifest {
    name            = 'cnv_normal'
    author          = 'Bionl'
    homePage        = 'https://github.com/bionl/cnv_normal'
    description     = 'Build a CNVkit panel-of-normals reference from normal BAMs'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
